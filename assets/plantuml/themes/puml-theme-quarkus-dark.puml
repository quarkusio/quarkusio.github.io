!define QUARKUS_RED #FF004A
!define MAIN_BACKGROUND #121212
!define MAIN_TEXT #B5B5B5
!define LINK_BLUE #9BCAFA
!define DEEP_BLUE #205894
!define DARK_BLUE #0D1C2C
!define DARKER_BLUE #1A2332
!define DATABASE_BLUE #1A3A5C
!define SEC_BACKGROUND #333333
!define SEC_BORDER #555555
!define DARK_PURPLE_BG #2E2547
!define LIGHT_PURPLE_BORDER #B7A6E0
!define CARD_BACKGROUND #1E1E1E
!define QUARKUS_ICON <$quarkus*0.078>

