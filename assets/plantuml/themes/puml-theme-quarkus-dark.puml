skinparam dpi 300

skinparam backgroundColor MAIN_BACKGROUND

skinparam defaultFontName "Open Sans"
skinparam defaultFontColor MAIN_TEXT
skinparam defaultFontSize 14
skinparam shadowing true
skinparam shadowColor #000000
skinparam roundCorner 10

skinparam node {
    borderColor LINK_BLUE
    backgroundColor DARK_BLUE
    fontName "Open Sans"
    fontSize 17
    fontColor LINK_BLUE
    roundCorner 10
}

skinparam rectangle {
    borderColor LINK_BLUE
    backgroundColor DARK_BLUE
    fontName "Open Sans"
    fontSize 17
    fontColor LINK_BLUE
    roundCorner 10
}

skinparam database {
    borderColor LINK_BLUE
    backgroundColor DATABASE_BLUE
    fontColor LINK_BLUE
}

skinparam agent {
    backgroundColor<<frontend>> QUARKUS_BLUE
    fontColor<<frontend>> #FFFFFF
    borderColor<<frontend>> LINK_BLUE
    backgroundColor<<application>> SEC_BACKGROUND
    fontColor<<application>> MAIN_TEXT
    borderColor<<application>> SEC_BORDER
}

skinparam participant {
    backgroundColor<<frontend>> QUARKUS_BLUE
    fontColor<<frontend>> #FFFFFF
    borderColor<<frontend>> LINK_BLUE
    backgroundColor<<application>> SEC_BACKGROUND
    fontColor<<application>> MAIN_TEXT
    borderColor<<application>> SEC_BORDER
}

skinparam arrow {
    fontName "Open Sans"
    color QUARKUS_RED
    fontColor MAIN_TEXT
    thickness 2
    fontSize 13
}

skinparam class {
    backgroundColor SEC_BACKGROUND
    borderColor SEC_BORDER
    fontColor MAIN_TEXT
    attributeFontColor MAIN_TEXT
    attributeFontName "Open Sans"
}

skinparam component {
    backgroundColor DEEP_BLUE
    borderColor LINK_BLUE
    fontColor #FFFFFF
}

skinparam package {
    borderColor LINK_BLUE
    backgroundColor DARKER_BLUE
    fontColor LINK_BLUE
    fontSize 14
    style rectangle
}

skinparam hexagon {
    backgroundColor DARK_PURPLE_BG
    borderColor LIGHT_PURPLE_BORDER
    fontColor MAIN_TEXT
}

skinparam cloud {
    backgroundColor CARD_BACKGROUND
    borderColor LINK_BLUE
    fontColor MAIN_TEXT
}

skinparam interface {
    backgroundColor QUARKUS_BLUE
    borderColor LINK_BLUE
    fontColor LINK_BLUE
}

skinparam sequence {
    lifeLineBorderColor LINK_BLUE
    lifeLineBackgroundColor DARKER_BLUE
    activationBackgroundColor DARK_BLUE
    activationBorderColor LINK_BLUE
}
