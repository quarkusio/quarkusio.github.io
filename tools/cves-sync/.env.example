# Quarkus loads this file automatically at startup.
# Copy this file to .env and fill in your token — it is git-ignored.
#
# Generate a token at https://github.com/settings/tokens
# Required scopes: none (public advisory data only needs read access)
# A fine-grained token with no extra permissions is sufficient.
#
# Without GITHUB_TOKEN : 60 requests/hour  (unauthenticated)
# With    GITHUB_TOKEN : 5,000 requests/hour (authenticated)

GITHUB_TOKEN=
